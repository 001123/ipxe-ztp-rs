**/config/local.yaml
**/config/*.local.yaml

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# include cargo lock
!Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

*.sqlite
*.sqlite-*

# Local runtime artifacts (test/dev sqlite databases live here)
tmp/*
!tmp/.gitkeep

# Local environment overrides (may contain dev credentials in plaintext)
.env

plan/

# Local secrets (Proxmox API credentials, ...) — never commit
secret/*
!secret/*.example

# Frontend baked into the release binary (populated by `mise run build-prod`)
assets/

# OS image store — extracted Ubuntu ISOs + downloaded .iso files (several GB of
# runtime data, re-downloadable; never commit)
data/os/

# Logs
logs/
*.log

# Editor / IDE
.idea/
.vscode/
*.sw?

# Test artifacts
# Insta: pending snapshots created when a snapshot needs review (`.snap.new`)
*.snap.new
# Test-run sqlite databases (dev seeds / harness dumps)
*.sqlite-shm
*.sqlite-wal
tests/**/*.sqlite
tests/**/*.db

# macOS
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.FDS-Store
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent


