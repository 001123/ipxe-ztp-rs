# ==============================================================================
# Proxmox VE API Credentials Configuration
# Copy this file to proxmox-credentials.env and fill in your details:
#   cp secret/proxmox-credentials.env.example secret/proxmox-credentials.env
# The secret/ directory is gitignored — never commit real credentials.
# ==============================================================================

# Proxmox VE Server URL (including port 8006)
PVE_HOST="https://<pve-host-or-ip>:8006"

# Target Proxmox Node Name (default: 'pve')
PVE_NODE="pve"

# Proxmox API Token Authentication (Recommended)
# To generate in PVE Web GUI:
# Datacenter -> Permissions -> API Tokens -> Add
# User: root@pam | Token ID: ipxe-token | Uncheck "Privilege Separation"
PVE_TOKEN_ID="root@pam!ipxe"
PVE_TOKEN_SECRET="<token-secret-uuid>"

# Set to true to bypass self-signed certificate warnings
PVE_INSECURE="true"

# Default Network Bridge and Storage pool on Proxmox
PVE_BRIDGE="vmbr0"
PVE_STORAGE="local-lvm"