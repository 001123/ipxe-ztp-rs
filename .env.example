# Example environment file — copy to .env and adjust values:
#   cp .env.example .env
# .env is gitignored (may contain dev credentials in plaintext).

# Enables dev conveniences for the frontend (see IPXE_ZTP_TEST_* below).
IPXE_ZTP_IS_TEST=true

# Dev auto-fill login (frontend). When IPXE_ZTP_IS_TEST=true, vite.config.ts injects
# IPXE_ZTP_TEST_EMAIL/IPXE_ZTP_TEST_PASSWORD into the client bundle and the login form starts
# pre-filled. Leave IPXE_ZTP_TEST_PASSWORD empty (or set IPXE_ZTP_IS_TEST=false) to disable.
# Only takes effect for `vite dev` — production builds never include these.
IPXE_ZTP_TEST_EMAIL=admin@ipxe.local
IPXE_ZTP_TEST_PASSWORD=admin@pwd

# Global default SSH key seed. When IPXE_ZTP_IS_TEST=true, DevSshKeyInitializer installs
# this as the global `ssh_key` setting at boot — only if the setting is still
# empty, so a key set via the admin Settings page is never overwritten.
IPXE_ZTP_TEST_SSH_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKeyPlaceholder you@host"